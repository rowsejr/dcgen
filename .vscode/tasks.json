{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dcgen: new project",
      "detail": "Start projects/<name>/brief.yaml + site.yaml from the examples (schema-linked)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "project",
        "new",
        "${input:projectName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "dcgen",
          "fileLocation": "absolute",
          "source": "dcgen",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ]
    },
    {
      "label": "dcgen: check this project",
      "detail": "Validate brief.yaml + site.yaml of the open file's project; errors land in the Problems panel (no AI)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "project",
        "check",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "dcgen",
          "fileLocation": "absolute",
          "source": "dcgen",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "group": "test"
    },
    {
      "label": "dcgen: run this project",
      "detail": "Lay out the open file's project and write out/summary.md (about 10 s, no AI)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "project",
        "run",
        "${file}",
        "--formats",
        "json"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "dcgen",
          "fileLocation": "absolute",
          "source": "dcgen",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "dcgen: run this project (all deliverables)",
      "detail": "As above plus the A3 PDF, IFC (Revit/Navisworks), DXF, GLB and the drag editor",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "project",
        "run",
        "${file}",
        "--formats",
        "json,pdf,ifc,dxf,glb,editor"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "dcgen",
          "fileLocation": "absolute",
          "source": "dcgen",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "group": "build"
    },
    {
      "label": "dcgen: peak PUE for this project",
      "detail": "Peak PUE build-up, chiller EER and the 600 kW lineup check for the open project's brief (no site needed)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "project",
        "peak",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "dcgen",
          "fileLocation": "absolute",
          "source": "dcgen",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ]
    },
    {
      "label": "dcgen: validate plant library",
      "detail": "Check the records in the packs set by the dcgen.packs setting",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "library",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "dcgen: refresh YAML schemas",
      "detail": "Regenerate schemas/brief.schema.json and site.schema.json after a schema change",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "dcgen.cli",
        "project",
        "schema"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "dcgen: web app (no AI)",
      "detail": "Form, REST API and MCP endpoint at http://localhost:8000",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "uvicorn",
        "dcgen.api:app",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "dcgen-web",
          "pattern": {
            "regexp": "^__dcgen_never_matches__(.)(\\d)(.)$",
            "file": 1,
            "line": 2,
            "message": 3
          },
          "background": {
            "activeBegin": true,
            "beginsPattern": "Will watch for changes",
            "endsPattern": "Application startup complete"
          }
        }
      ],
      "isBackground": true
    },
    {
      "label": "dcgen: fast tests",
      "detail": "Engine and workspace tests (seconds)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q",
        "tests/test_engines.py",
        "tests/test_workspace.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "dcgen: full tests",
      "detail": "Whole suite (a few minutes)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "dcgen: install / update",
      "detail": "Install dcgen into the selected Python environment",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pip",
        "install",
        "-e",
        ".[all]"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DCGEN_PACKS": "${config:dcgen.packs}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "projectName",
      "type": "promptString",
      "description": "New project folder name (letters, digits, - _)",
      "default": "my-test-fit"
    }
  ]
}
